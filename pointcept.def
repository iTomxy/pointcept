# pointcept
Bootstrap: docker
From: pointcept/pointcept:v1.6.0-pytorch2.5.0-cuda12.4-cudnn9-devel
# Bootstrap: localimage
# From: /share/pointcept_ori.sif

%labels

Python 3.11.10
CUDA 12.4
cuDNN 9
PyTorch 2.5.0+cu124
torchvision 0.20.0+cu124

%environment

export PYTHONPATH=.

%post

# required by UTS iHPC
export DEBIAN_FRONTEND=noninteractive
mkdir -p /data /projects /scratch

# python packages
/opt/conda/bin/pip install --upgrade pip setuptools wheel
/opt/conda/bin/pip uninstall -y open3d-cpu
/opt/conda/bin/pip install --no-cache-dir \
    scikit-learn scikit-image opencv-python-headless pyyaml \
    SimpleITK nibabel medpy itk jupyterlab ipykernel open3d seaborn

# install jupyter kernel
/opt/conda/bin/python -m ipykernel install --name "pointcept" --display-name "Pointcept (singularity)"

# let `py` point to the right python
ln -s /opt/conda/bin/python /usr/local/bin/py
ln -s /opt/conda/bin/pip /usr/local/bin/pi
